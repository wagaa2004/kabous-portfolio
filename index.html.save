<style>
body{margin:0;background:#020a02;color:#0f0;font-family:monospace;overflow-x:hidden}
.matrix{position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;opacity:0.15}
.container{max-width:900px;margin:40px auto;padding:20px;border:1px solid #0f0;box-shadow:0 0 20px #0f0}
h1{font-size:60px;text-align:center;text-shadow:0 0 10px #0f0;margin:0}
h1 span{color:#fff}
.type{ text-align:center; font-size:22px; color:#fff; margin:20px}
.card{border:1px dashed #0f0;padding:15px;margin:15px 0}
a{color:#0f0;text-decoration:none;border:1px solid #0f0;padding:10px 20px;display:inline-block}
a:hover{background:#0f0;color:#000}
</style>
</head>
<body>
<canvas class="matrix" id="c"></canvas>
<div class="container">
