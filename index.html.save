<script>
var c=document.getElementById("c"), ctx=c.getContext("2d");
c.width=window.innerWidth; c.height=window.innerHeight;
var chars="01KABOUS"; chars=chars.split(""); var cols=c.width/14; var drops=[];
for(var x=0;x<cols;x++) drops[x]=1;
function draw(){ctx.fillStyle="rgba(0,10,0,0.05)";ctx.fillRect(0,0,c.width,c.height);ctx.fillStyle="#0f0";ctx.font="14px monospace";
for(var i=0;i<drops.length;i++){var t=chars[Math.floor(Math.random()*chars.length)];ctx.fillText(t,i*14,drops[i]*14);
if(drops[i]*14>c.height&&Math.random()>0.975) drops[i]=0; drops[i]++;}} setInterval(draw,35);
</script>
</body>
